# Copy to .env.local and fill in

# ── Posting ──────────────────────────────────────────────
# "mock" (works out of the box), "outstand", "postforme", "blotato" or "ayrshare"
POSTING_PROVIDER=mock
# Outstand API key (outstand.so -> API key) — RECOMMENDED: true usage-based
# pricing, $19/mo includes 3,000 posts then $0.005-0.007/post, no plan-tier
# video restriction, white-label/BYO-app mode for agency reselling.
OUTSTAND_API_KEY=
# Outstand organization ID (outstand.so dashboard) — needed for the embedded
# "Connect account" OAuth flow (app/api/accounts/connect) so users approve
# access on the real platform's login screen without leaving the app.
# Also add {APP_URL}/api/accounts/callback as an allowed redirect URI in
# Outstand's dashboard settings (one-time setup).
OUTSTAND_ORG_ID=
# Post for Me API key (postforme.dev) — usage-tiered, $10/mo for 1,000 posts
POSTFORME_API_KEY=
# Blotato API key (blotato.com -> Settings -> API), needed when POSTING_PROVIDER=blotato
BLOTATO_API_KEY=
# Ayrshare API key (app.ayrshare.com) — video posting needs their $149/mo
# Premium plan, so only worth it if you're already invested in their dashboard
AYRSHARE_API_KEY=

# ── AI content (scripts, ideas, SEO, captions) ───────────
# console.anthropic.com — without it, template fallbacks are used
ANTHROPIC_API_KEY=

# ── Video generation ─────────────────────────────────────
# Voice-over: platform.openai.com — without it, videos render with a silent track
OPENAI_API_KEY=
# Stock footage: free key from pexels.com/api — without it, animated gradient slides are used
PEXELS_API_KEY=
# Optional: YouTube Data API key for niche trending research (console.cloud.google.com)
YOUTUBE_API_KEY=

# Marketing Studio / Creator Studio: AI video generation via fal.ai
# (fal.ai/dashboard/keys, pay-as-you-go, no subscription).
# Without it, these studios render a free slideshow/zoom mock instead.
FAL_KEY=
# Optional overrides of the fal.ai models used per resolution tier
FAL_MODEL_480P=
FAL_MODEL_720P=
FAL_MODEL_1080P=
FAL_TEXT_MODEL_480P=
FAL_TEXT_MODEL_720P=
FAL_TEXT_MODEL_1080P=

# Voice cloning — fixes AI mispronunciation of African names/words by using
# a voice the creator recorded themselves (elevenlabs.io -> Profile -> API Key)
ELEVENLABS_API_KEY=

# ── App ──────────────────────────────────────────────────
# Public URL (needed so posting providers can fetch your rendered videos)
APP_URL=http://localhost:3000
# Protects /api/worker in production
WORKER_SECRET=

# ── Payments (Paddle / Lemon Squeezy / Flutterwave links) ─
# When set, pricing-page buttons link straight to checkout
PAYMENT_LINK_PUBLISHER=
PAYMENT_LINK_CREATOR=
PAYMENT_LINK_AUTOPILOT=
PAYMENT_LINK_STUDIO=
